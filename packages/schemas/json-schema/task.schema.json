{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/task.schema.json",
  "title": "Aether Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "objective", "inputs", "outputs", "dependencies", "scope", "acceptance_criteria"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "role": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "array", "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativeProjectPath" } },
        "forbidden_paths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativeProjectPath" } },
        "exclusive_paths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativeProjectPath" } },
        "shared_paths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativeProjectPath" } }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification_method", "required"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "verification_method": { "enum": ["automated", "manual", "review", "evidence"] },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
