{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/workflow.schema.json",
  "title": "Aether Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "inputs",
    "stages",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "entry_stages": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {}
      }
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^(input|project|capability|stage)\\.[A-Za-z0-9_.-]+$"
            }
          }
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array",
            "object"
          ]
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "left",
                "right"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "eq",
                    "neq",
                    "in"
                  ]
                },
                "left": {
                  "$ref": "#/$defs/operand"
                },
                "right": {
                  "$ref": "#/$defs/operand"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "items"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "and",
                    "or"
                  ]
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/condition"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "item"
              ],
              "properties": {
                "op": {
                  "const": "not"
                },
                "item": {
                  "$ref": "#/$defs/condition"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "const": "exists"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^(input|project|capability|stage)\\.[A-Za-z0-9_.-]+$"
                }
              }
            }
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skill",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "skill": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "required": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "optional",
                "required"
              ]
            },
            "risk": {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "required_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/identifier"
              }
            }
          },
          "required": [
            "mode"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_paths": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/relativeProjectPath"
              },
              "uniqueItems": true
            },
            "write_paths": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/relativeProjectPath"
              },
              "uniqueItems": true
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_stages"
      ],
      "properties": {
        "required_stages": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
