{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/trusted-approvers.schema.json",
  "title": "Aether Trusted Approver Key Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "issuer",
          "subject",
          "algorithm",
          "public_key_pem",
          "roles",
          "status"
        ],
        "properties": {
          "key_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_pem": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            }
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
