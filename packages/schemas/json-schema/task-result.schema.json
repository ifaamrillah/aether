{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/task-result.schema.json",
  "title": "Aether Task Result Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "stage_id",
    "summary",
    "changed_files",
    "evidence"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "task_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "stage_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "summary": { "type": "string", "minLength": 1 },
    "changed_files": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/relativeProjectPath" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "result"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relativeProjectPath" },
          "type": {
            "enum": [
              "test_report",
              "build_log",
              "screenshot",
              "trace",
              "review_record",
              "security_scan",
              "design_artifact",
              "documentation",
              "other"
            ]
          },
          "result": { "enum": ["passed", "informational", "failed"] },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
