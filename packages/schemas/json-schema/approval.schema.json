{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/approval.schema.json",
  "title": "Aether Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "action", "status", "requested_at", "requested_by", "policy_version"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "risk", "requested_by", "context"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "target": { "type": "string" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "requested_by": { "type": "string" },
        "context": { "type": "object" }
      }
    },
    "status": { "enum": ["pending", "approved", "rejected", "expired", "revoked"] },
    "requested_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "requested_by": { "type": "string" },
    "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "decided_by": { "type": "string" },
    "decision_reason": { "type": "string" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "policy_version": { "type": "string" },
    "action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
